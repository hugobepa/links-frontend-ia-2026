---
import { getTranslations } from '../i18n';
import type { Category } from '../interfaces/categories';

interface Props {
  categories: Category[];
  currentSlug: string;
  lang?: 'es' | 'en';
}

const { categories, currentSlug, lang = 'es' } = Astro.props;
const t = getTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="hidden lg:block">
  <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
    <div class="mb-4">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Navigation</p>
      <h2 class="mt-1 text-lg font-bold text-gray-900">{t.nav.categories}</h2>
    </div>

    <div class="space-y-3">
      {categories.map((item) => {
        const isCurrent = item.slug === currentSlug;
        const prefix = `${baseUrl}${lang === 'en' ? '/en' : ''}`;

        return (
          <details open={isCurrent} class="group rounded-xl border border-gray-200 p-3">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
              <a
                href={`${prefix}/categories/${item.slug}`}
                class={`text-sm font-semibold ${isCurrent ? 'text-blue-700' : 'text-gray-900'}`}
              >
                {item.name}
              </a>
              <span class="text-gray-400 transition-transform group-open:rotate-180">⌄</span>
            </summary>
            <div class="mt-3 space-y-2 pl-1">
              {item.subcategories.map((subcategory: Category['subcategories'][number]) => (
                <a
                  href={isCurrent ? `#${subcategory.id}` : `${prefix}/categories/${item.slug}#${subcategory.id}`}
                  class="block rounded-lg px-2 py-1 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900"
                >
                  {subcategory.name}
                </a>
              ))}
            </div>
          </details>
        );
      })}
    </div>
  </div>
</aside>

<div class="lg:hidden mb-4">
  <details class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
      <span class="flex items-center gap-2 text-sm font-semibold text-gray-900">
        <span>☰</span>
        {t.nav.categories}
      </span>
      <span class="text-gray-400">⌄</span>
    </summary>
    <div class="mt-4 space-y-2">
      {categories.map((item) => {
        const mobilePrefix = `${baseUrl}${lang === 'en' ? '/en' : ''}`;
        return (
          <a
            href={`${mobilePrefix}/categories/${item.slug}`}
            class="block rounded-lg border border-gray-200 px-3 py-2 text-sm font-medium text-gray-900"
          >
            {item.name}
          </a>
        );
      })}
    </div>
  </details>
</div>
