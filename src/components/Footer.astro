---
// filepath: src/components/Footer.astro
import { getTranslations } from '../i18n';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
---

<footer class="footer">
  <div class="footer__container">
    <p class="footer__copyright">{t.footer.copyright}</p>
    <p class="footer__description">{t.footer.description}</p>
    <div class="footer__links">
      <a href="#" class="footer__link">{t.footer.privacy}</a>
      <a href="#" class="footer__link">{t.footer.terms}</a>
      <a href="#" class="footer__link">{t.footer.contact}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border, #e5e7eb);
    background: var(--color-bg-secondary, #f9fafb);
    margin-top: 4rem;
  }

  .footer__container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .footer__copyright {
    font-size: 0.875rem;
    color: var(--color-text, #111);
    margin: 0 0 0.5rem;
  }

  .footer__description {
    font-size: 0.75rem;
    color: var(--color-text-muted, #6b7280);
    margin: 0 0 1rem;
  }

  .footer__links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .footer__link {
    font-size: 0.75rem;
    color: var(--color-text-muted, #6b7280);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer__link:hover {
    color: var(--color-primary, #B46D46);
  }
</style>