---
import { BackToTop } from '@/components/BackToTop';
import CategorySearch from '@/components/CategorySearch';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { getTranslations } from '@/i18n';
import { loadAllCategories } from '@/lib/loaders';
import '@/styles/global.css';

const categories = await loadAllCategories();

const urlPath = Astro.url.pathname;
const isEnglish = urlPath.startsWith('/en') || urlPath.includes('/en/');
const lang = isEnglish ? 'en' : 'es';

const t = getTranslations(lang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.nav.categories} - Links Frontend IA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header lang={lang} />
    
    <main class="max-w-6xl mx-auto px-4 py-12">
      <h1 class="text-3xl font-bold mb-4">{t.nav.categories}</h1>
      <p class="text-gray-600 mb-8">{t.categories.subtitle}</p>
      
      <CategorySearch 
        client:load 
        categories={categories} 
        lang={lang}
        translations={{
          placeholder: t.search.placeholder,
          noResults: t.search.noResults
        }}
      />

    </main>
    
    <Footer lang={lang} />
    <BackToTop client:load lang={lang} />
  </body>
</html>
