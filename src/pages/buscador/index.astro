---
import { BackToTop } from '@/components/BackToTop';
import Footer from '@/components/Footer.astro';
import GlobalSearch from '@/components/GlobalSearch';
import Header from '@/components/Header.astro';
import SEO from '@/components/SEO.astro';
import { getTranslations } from '@/i18n';
import { loadAllResources } from '@/lib/loaders';
import '@/styles/global.css';

const resources = await loadAllResources();

const urlPath = Astro.url.pathname;
const isEnglish = urlPath.startsWith('/en') || urlPath.includes('/en/');
const lang = isEnglish ? 'en' : 'es';

const t = getTranslations(lang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <SEO
      title={`${t.nav.search} - Links Frontend IA`}
      description={t.categories.subtitle}
      canonicalPath={lang === 'en' ? '/en/buscador' : '/buscador'}
      lang={lang}
      alternatePaths={{ es: '/buscador', en: '/en/buscador' }}
    />
  </head>
  <body>
    <Header lang={lang} />
    
    <main class="max-w-6xl mx-auto px-4 py-12">
      <h1 class="text-3xl font-bold mb-4">{t.nav.search}</h1>
      <p class="text-gray-600 mb-8">{t.categories.subtitle}</p>
      
      <GlobalSearch 
        client:load 
        resources={resources} 
        lang={lang}
        translations={{
          placeholder: t.search.placeholder,
          noResults: t.search.noResults,
          all: t.search.all,
          free: t.search.free,
          freemium: t.search.freemium,
          premium: t.search.premium,
          paid: t.search.paid,
          results: t.search.results
        }}
      />
    </main>
    
    <Footer lang={lang} />
    <BackToTop client:load lang={lang} />
  </body>
</html>