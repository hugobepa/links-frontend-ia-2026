---
// filepath: src/pages/en/categories/[slug].astro
import CategoryNavigation from '@/components/CategoryNavigation.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SEO from '@/components/SEO.astro';
import SubcategorySection from '@/components/SubcategorySection';
import { getTranslations } from '@/i18n';
import type { Category } from '@/interfaces/categories';
import { loadAllCategories, loadCategory } from '@/lib/loaders';
import '@/styles/global.css';

// Pre-generate paths for all categories at build time
export async function getStaticPaths() {
  const categories = await loadAllCategories();
  const paths = [];
  
  // Generate English paths
  for (const cat of categories) {
    paths.push({ params: { slug: cat.slug }, props: { lang: 'en' } });
  }
  
  return paths;
}

interface Props {
  params: { slug: string };
}

const { slug } = Astro.params;
const categories = await loadAllCategories();
const category: Category | null = await loadCategory(slug);

// Force English
const lang = 'en';
const t = getTranslations(lang);

if (!category) {
  return Astro.redirect('/404');
}

---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={`${category.name} - Links Frontend IA`}
      description={category.description}
      canonicalPath={`/en/categories/${slug}`}
      lang={lang}
      alternatePaths={{ es: `/categories/${slug}`, en: `/en/categories/${slug}` }}
    />
  </head>
  <body id="top">
    <Header lang={lang} />

    <main class="main">
      <div class="page-container">
        <div class="page-grid">
          <CategoryNavigation categories={categories} currentSlug={category.slug} lang={lang} />

          <section class="content">
            <div class="warning-banner">
              <h2 class="warning-text">
                Links are current until April 2026 and may change
              </h2>
            </div>

            <div class="category-header">
              <h1 class="category-title">{category.name}</h1>
              <p class="category-description">{category.description}</p>
            </div>

            {category.subcategories.length === 0 ? (
              <div class="empty-state">
                <p>{t.search.noResults}</p>
              </div>
            ) : (
              <div class="subcategories">
                {category.subcategories.map((subcategory) => (
                  <SubcategorySection subcategory={subcategory} client:load lang={lang} />
                ))}
              </div>
            )}
          </section>
        </div>
      </div>

      <a href="#top" class="back-to-top">↑ Top</a>
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  html {
    font-family: system-ui, sans-serif;
    background: var(--color-bg, #f8f5f0);
    color: var(--color-text, #111);
  }
  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .main {
    flex: 1;
  }
  .page-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem;
  }
  .page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .page-grid {
      grid-template-columns: 280px 1fr;
    }
  }
  .content {
    min-width: 0;
  }
  .warning-banner {
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid #fecaca;
    background: #fef2f2;
    border-radius: 0.5rem;
    text-align: center;
  }
  .warning-text {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #b91c1c;
    margin: 0;
  }
  .category-header {
    margin-bottom: 2rem;
  }
  .category-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-text, #111);
    margin: 0 0 0.5rem;
  }
  .category-description {
    color: var(--color-text-muted, #6b7280);
    margin: 0;
  }
  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted, #6b7280);
  }
  .subcategories {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .back-to-top {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 50;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #e5e7eb);
    background: var(--color-bg, #fff);
    color: var(--color-text, #111);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 9999px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  @media (min-width: 1024px) {
    .back-to-top {
      bottom: 2rem;
      right: 2rem;
    }
  }
  .back-to-top:hover {
    background: var(--color-primary, #B46D46);
    color: white;
    border-color: var(--color-primary, #B46D46);
  }
</style>